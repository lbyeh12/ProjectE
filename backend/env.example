# backend/.env.example
# 실제 사용 시 이 파일을 복사해서 .env 로 만들고 값을 채운다.
# .env 는 .gitignore에 의해 저장소에 올라가지 않는다.

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/projecte
FRONTEND_ORIGIN=http://localhost:5173
ENV=local

# Kafka (docker compose 로 Kafka를 띄운 경우, 로컬 실행 시 localhost:9092)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EVENTS_TOPIC=user-events
USE_KAFKA=true
